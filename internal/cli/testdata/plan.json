    "org.eclipse.core.databinding": {
      "groupId": "org.eclipse.platform",
      "artifactId": "org.eclipse.core.databinding"
    },
    "org.eclipse.core.databinding.beans": {
      "groupId": "org.eclipse.platform",
      "artifactId": "org.eclipse.core.databinding.beans"
    },
    "org.eclipse.core.databinding.observable": {
      "groupId": "org.eclipse.platform",
      "artifactId": "org.eclipse.core.databinding.observable"
    },
    "org.eclipse.core.databinding.property": {
      "groupId": "org.eclipse.platform",
      "artifactId": "org.eclipse.core.databinding.property"
    },
    "org.eclipse.equinox.common": {
      "groupId": "org.eclipse.platform",
      "artifactId": "org.eclipse.equinox.common"
