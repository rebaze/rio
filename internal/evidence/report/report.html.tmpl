<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Rio client evidence</title>
<style>
:root{color-scheme:light;--ink:#17324d;--muted:#516777;--accent:#156c8a;--line:#dce6ed;--wash:#edf5f8;--exception:#9d432d}
*{box-sizing:border-box}body{margin:0;background:#fff;color:var(--ink);font:16px/1.55 Arial,Helvetica,sans-serif}a{color:var(--accent)}a:focus-visible,summary:focus-visible{outline:3px solid var(--accent);outline-offset:4px}header{border-left:8px solid var(--accent);padding:28px 32px 24px;margin:36px auto 28px;max-width:1120px;background:var(--wash)}h1,h2,h3{font-family:Charter,"Bitstream Charter",Georgia,serif;line-height:1.18;font-weight:600;overflow-wrap:anywhere}h1{font-size:clamp(2.2rem,4vw,3.1rem);margin:8px 0 12px}h2{font-size:1.85rem;margin:0 0 18px}h3{font-size:1.4rem;margin:0 0 12px}h4{font-size:1rem;margin:22px 0 8px}p{max-width:78ch;margin:10px 0}header .brand{font-size:1.05rem;font-weight:700;color:var(--accent)}.lede{font-size:1.1rem}.provenance{margin-top:22px;font-size:.86rem;color:var(--muted)}.layout{display:grid;grid-template-columns:176px minmax(0,1fr);gap:36px;max-width:1120px;margin:0 auto;padding:0 16px 64px}nav{position:sticky;top:24px;align-self:start;font-size:.9rem}nav a{display:block;padding:8px 10px;border-left:2px solid var(--line);text-decoration:none}nav a:hover{border-color:var(--accent);background:var(--wash)}main{min-width:0}section{padding:24px 0 34px;border-bottom:1px solid var(--line);scroll-margin-top:20px}.muted{color:var(--muted)}.note{padding:12px 16px;background:var(--wash);border-left:3px solid var(--accent);margin:16px 0}.exception{border-left:3px solid var(--exception);padding:8px 16px;margin:12px 0}.exception strong{color:var(--exception)}article{padding:22px 0;border-top:1px solid var(--line)}article:first-of-type{border-top:0}.facts{display:grid;grid-template-columns:minmax(130px,1fr) minmax(0,3fr);gap:7px 16px;margin:14px 0}.facts dt{color:var(--muted)}.facts dd{margin:0;min-width:0;overflow-wrap:anywhere}code,pre{font: .86rem/1.55 "SFMono-Regular",Consolas,"Liberation Mono",monospace;overflow-wrap:anywhere;word-break:break-word}pre{white-space:pre-wrap;margin:6px 0;max-width:100%}code{white-space:pre-wrap}.digest{font-size:.8rem}table{border-collapse:collapse;table-layout:fixed;width:100%;margin:14px 0 22px;font-size:.91rem}th{text-align:left;font-size:.83rem;font-weight:700;color:var(--muted);border-bottom:2px solid var(--line);padding:9px 10px}td{vertical-align:top;border-bottom:1px solid var(--line);padding:12px 10px;overflow-wrap:anywhere}td:first-child,th:first-child{padding-left:0}td:last-child,th:last-child{padding-right:0}.changes th:first-child{width:28%}.changes th:not(:first-child){width:36%}.changes .rule{font-size:.78rem;color:var(--muted);margin-top:5px}.before{color:#675965}.after{color:var(--ink)}details{margin:12px 0;padding:10px 14px;border:1px solid var(--line);border-radius:5px;min-width:0}summary{cursor:pointer;color:var(--accent);overflow-wrap:anywhere}details details{padding:8px;margin:8px 0}.timeline{padding-left:26px}.timeline>li{padding:5px 0 18px 10px}.timeline>li::marker{color:var(--accent);font-weight:700}.event-heading{font-weight:700}.event-time{display:block;color:var(--muted);font-size:.8rem}.observations{padding-left:20px}.compact{font-size:.86rem}.boundary{margin:10px 0}.source-kind{font-weight:700}footer{padding:24px 0;color:var(--muted);font-size:.86rem}.empty{color:var(--muted);font-style:italic}ul{padding-left:22px}li{overflow-wrap:anywhere}time{overflow-wrap:anywhere}
@media(max-width:760px){header{margin:0 0 18px;padding:24px 18px;border-left-width:5px}.layout{display:block;padding:0 18px 40px}nav{position:static;display:flex;flex-wrap:wrap;gap:2px;margin-bottom:12px}nav a{padding:6px 10px}section{padding-top:24px}.facts{grid-template-columns:1fr;gap:2px}.facts dd{margin-bottom:10px}}
@media(max-width:580px){table.responsive,table.responsive tbody,table.responsive tr,table.responsive td{display:block;width:100%}table.responsive thead{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}table.responsive tr{border-bottom:1px solid var(--line);padding:10px 0}table.responsive td{border:0;padding:7px 0}table.responsive td::before{content:attr(data-label);display:block;color:var(--muted);font-size:.78rem;font-weight:700;margin-bottom:4px}h2{font-size:1.65rem}details{padding:10px}code,pre{font-size:.81rem}}
@media print{nav{display:none}.layout{display:block;max-width:none}header{margin:0;max-width:none}body{font-size:10pt}section{break-before:auto}h2,h3,h4{break-after:avoid}details{break-inside:avoid}a{text-decoration:none;color:inherit}}
</style>
</head>
<body>
<header>
<div class="brand">Rio</div>
<h1>Client evidence</h1>
<p class="lede">What Rio selected, changed, checked and retained.</p>
<p>{{count (len .Artifacts) "artifact" "artifacts"}}. {{count (len .Attempts) "selected delivery attempt" "selected delivery attempts"}}. Record format {{.SchemaVersion}}.</p>
<div class="provenance">Exact input JSON SHA-256<br><code class="digest">{{.RecordSHA256}}</code></div>
<p class="compact">Keep the original JSON for machine inspection. This report shows internally consistent recorded facts; it does not authenticate their producer.</p>
</header>
<div class="layout">
<nav aria-label="Report sections"><a href="#scope">Scope</a><a href="#work">Work performed</a><a href="#checks">Effective checks</a><a href="#delivery">Delivery history</a><a href="#exceptions">Exceptions and gaps</a><a href="#evidence">Evidence sources</a></nav>
<main>
<section id="scope"><h2>Scope</h2>
<p>Normalization selection detail: <strong>{{.ScopeStatus}}</strong>. Expected delivery scope: <strong>{{.ExpectedScope}}</strong>.</p>
{{with .Scope}}<dl class="facts"><dt>Output spec floor</dt><dd>{{.SpecVersionFloor}}</dd><dt>Explicit artifacts</dt><dd>{{if .ExplicitArtifacts}}{{join .ExplicitArtifacts ", "}}{{else}}None{{end}}</dd></dl>
{{range .ArtifactSets}}<article><h3>{{.Source}}</h3><dl class="facts"><dt>Module selector</dt><dd><code>{{.Modules}}</code></dd><dt>SBOM selector</dt><dd><code>{{.SBOM}}</code></dd><dt>Declared exclusions</dt><dd>{{if .Exclude}}{{join .Exclude ", "}}{{else}}None{{end}}</dd><dt>Resolved members</dt><dd>{{join .ArtifactIDs ", "}}</dd></dl></article>{{end}}
<details><summary>Effective artifact settings</summary>{{range .Artifacts}}<h4>{{.ID}}</h4><p>Selected input: <code>{{.Input}}</code></p>{{range .Transforms}}<p>Transform: {{.Name}}</p><pre>{{json .Options}}</pre>{{else}}<p class="empty">No transforms declared.</p>{{end}}{{end}}</details>
{{else}}<p class="note">Original selectors and exclusions are not available in a supported extension. The retained artifact inventory remains available below; it does not describe modules outside the original selection.</p>{{end}}
</section>
<section id="work"><h2>Work performed</h2>
<p>{{if .ArtifactsWithChangeDetail}}{{count .Changes "recorded substantive change" "recorded substantive changes"}}. Supported detail is available for {{.ArtifactsWithChangeDetail}} of {{len .Artifacts}} artifacts.{{else}}Detailed normalization changes are not recorded in a supported extension.{{end}}</p>
{{range .Artifacts}}<article><h3>{{.Index.ID}}</h3><p>CycloneDX {{.Index.SpecVersion.Input}} to {{.Index.SpecVersion.Output}}. {{count .Index.Components "top-level component" "top-level components"}}.</p>
{{if .DetailKnown}}<p>{{.ChangedTop}} of {{count .Index.Components "top-level component" "top-level components"}} changed; unchanged: {{.UnchangedTop}}. Nested component changes are not implied.</p>{{if .Changes}}
<table class="changes responsive"><thead><tr><th>Change</th><th>Before</th><th>After</th></tr></thead><tbody>{{range .Changes}}<tr><td data-label="Change"><code>{{.Target}}</code><div class="rule">{{.Operation}} · {{.Rule}}</div>{{if .SourceKind}}<details><summary>Source: {{.SourceKind}}</summary><p>Selector: <code>{{.Selector}}</code></p>{{if .SHA256}}<p>Source SHA-256<br><code class="digest">{{.SHA256}}</code></p>{{end}}{{if .Assertions}}<p>Upstream assertions; Rio does not assign a probability:</p><pre>{{.Assertions}}</pre>{{end}}</details>{{end}}</td><td data-label="Before" class="before"><pre>{{.Before}}</pre></td><td data-label="After" class="after"><pre>{{.After}}</pre></td></tr>{{end}}</tbody></table>
{{else}}<p class="empty">No substantive changes recorded.</p>{{end}}{{else}}<p class="note">Detailed changes {{.ChangeStatus}}. This does not mean no work was performed.</p>{{end}}
{{if .Index.Transforms}}<table class="responsive"><thead><tr><th>Transform</th><th>Applied</th><th>Unmapped</th><th>Skipped</th></tr></thead><tbody>{{range .Index.Transforms}}<tr><td data-label="Transform">{{.ID}}</td><td data-label="Applied">{{.Applied}}</td><td data-label="Unmapped">{{.Unmapped}}</td><td data-label="Skipped">{{.Skipped}}</td></tr>{{end}}</tbody></table><p class="compact muted">Counts use each transform's top-level scope. Applied and unmapped can overlap when a qualifier changes but coordinates remain unresolved; these columns are not a partition of component membership.</p>{{end}}
{{range .Unmapped}}<p class="exception"><strong>Unresolved mapping</strong><br><code>{{.Target}}</code>: {{.Reason}}<br><code>{{.PURL}}</code></p>{{end}}
{{if .Skipped}}<details><summary>Out-of-scope outcomes</summary>{{range .Skipped}}<p>{{.Count}} skipped: {{.Reason}}. Rule {{.Rule}}; scope {{.Scope}}.</p>{{end}}</details>{{end}}
{{if .Bookkeeping}}<details><summary>Rio bookkeeping ({{count (len .Bookkeeping) "change" "changes"}})</summary>{{range .Bookkeeping}}<p><code>{{.Target}}</code> — {{.Operation}}, {{.Rule}}</p><pre>Before: {{.Before}}
After: {{.After}}</pre>{{end}}</details>{{end}}
{{if .Enrichment}}<details><summary>Supplied enrichment (producer assertion)</summary><pre>{{.Enrichment}}</pre></details>{{end}}{{if .Context}}<details><summary>Supplied context (producer assertion)</summary><pre>{{.Context}}</pre></details>{{end}}
<details><summary>Input and output correspondence</summary><dl class="facts"><dt>Input</dt><dd><code>{{.Index.Input.Path}}</code><br><code class="digest">{{.Index.Input.SHA256}}</code></dd><dt>Output</dt><dd><code>{{.Index.Output.Path}}</code><br><code class="digest">{{.Index.Output.SHA256}}</code></dd></dl><p class="compact">Digests are retained source facts. Full SBOM bytes are not included or rechecked here.</p></details>
</article>{{end}}</section>
<section id="checks"><h2>Effective checks</h2><p>Gate results, schema validation and graph findings answer different questions.</p>
{{range .Artifacts}}<article><h3>{{.Index.ID}}</h3><p>Recorded gate: <strong>{{.Index.Gate}}</strong>. Schema validated: {{.Index.SchemaValidated}}.</p>
{{with .Checks}}<dl class="facts"><dt>Requirement enforcement</dt><dd>{{if eq .Mode "fail"}}Fail on unmet requirements{{else}}Warn without failing normalization{{end}} ({{.Mode}})</dd><dt>Component scope</dt><dd>{{.ComponentScope}}</dd><dt>Components in scope</dt><dd>{{.ComponentCount}}</dd><dt>Component requirements</dt><dd>{{if .ComponentRequirements}}{{join .ComponentRequirements ", "}}{{else}}None selected{{end}}</dd><dt>Component evaluation</dt><dd>{{human .ComponentEvaluation}}</dd></dl>
<table class="responsive"><thead><tr><th>Requirement</th><th>Evaluated</th><th>Failed</th><th>Outcome</th></tr></thead><tbody>{{range .Evaluations}}<tr><td data-label="Requirement">{{.Scope}} / {{.Requirement}}</td><td data-label="Evaluated">{{.Evaluated}}</td><td data-label="Failed">{{.Failed}}</td><td data-label="Outcome">{{human .Outcome}}</td></tr>{{end}}</tbody></table>
<p>Schema validation: {{human .SchemaValidation}}. Graph check: {{human .GraphCheck}}; {{.GraphFindings}} findings.</p>
{{else}}<p class="note">Effective requirements {{.CheckStatus}}. The historical gate result is retained, but missing detail is not evidence that every requirement passed.</p>{{end}}
{{if .Index.GateFindings}}<details open><summary>Gate findings</summary>{{range .Index.GateFindings}}<p>{{if .Subject}}Subject{{else}}{{.Component}}{{end}}: missing {{join .Missing ", "}}</p>{{end}}</details>{{end}}
{{if .Index.IntegrityFindings}}<details><summary>Graph findings</summary><pre>{{json .Index.IntegrityFindings}}</pre></details>{{end}}
</article>{{end}}</section>
<section id="delivery"><h2>Delivery history</h2><p>{{if eq .ExpectedScope "recorded"}}Expected scope: recorded. {{count .SelectedPairs "selected pair entry" "selected pair entries"}} across {{count (len .Batches) "batch" "batches"}}. Repeated pairs keep every attempt.{{else}}Expected destinations were not recorded. The selected attempts below do not establish complete coverage.{{end}}</p>
{{range .Batches}}<article><h3>Batch scope</h3><code class="digest">{{.SHA256}}</code><dl class="facts"><dt>Normalization manifest</dt><dd><code class="digest">{{.Scope.NormalizationManifestSHA256}}</code></dd><dt>Delivery manifest</dt><dd><code class="digest">{{.Scope.DeliveryManifestSHA256}}</code></dd><dt>Ordinary completion</dt><dd>{{if .Completion}}{{.Completion.Outcome}} (runner assertion){{else}}Not recorded; interrupted work remains uncertain{{end}}</dd></dl>
<table class="responsive"><thead><tr><th>Artifact / target</th><th>Captured evidence</th><th>Acknowledgment</th><th>Runner state</th></tr></thead><tbody>{{range .Pairs}}<tr><td data-label="Artifact / target">{{.ArtifactID}} / {{.Target}}<br><code>{{.AttemptID}}</code></td><td data-label="Captured evidence">{{.Evidence}}</td><td data-label="Acknowledgment">{{human .Acknowledgment}}</td><td data-label="Runner state">{{human .RunnerState}}</td></tr>{{end}}</tbody></table>
{{range .Exclusions}}<p class="note">{{count .PairCount "excluded pair" "excluded pairs"}}: {{human .Reason}}. Artifacts: {{join .ArtifactIDs ", "}}. Targets: {{join .Targets ", "}}.</p>{{end}}
{{with .Completion}}<details><summary>Original runner completion assertion</summary><pre>{{json .}}</pre><p class="compact">This assertion cannot replace a missing receipt or override a committed acknowledgment.</p></details>{{end}}</article>{{end}}
{{range .Attempts}}<article><h3>{{.ArtifactID}} / {{.Target}}</h3><p>{{.Type}}. Original acknowledgment: <strong>{{.Acknowledgment}}</strong>.</p><p class="compact">Attempt <code>{{.ID}}</code></p><p>{{.Transport}}</p><p class="compact muted">{{.ContentSupport}}</p><details><summary>Prepared destination and policy</summary><pre>{{.Identity}}</pre><pre>{{.Options}}</pre></details>
<table class="responsive"><thead><tr><th>Submitted payload reference</th><th>Bytes</th><th>SHA-256</th></tr></thead><tbody>{{range .Facts.Intent.Payloads}}<tr><td data-label="Submitted payload reference">{{.Role}}<br>{{.MediaType}}<br>Transformation: {{.Transformation}}</td><td data-label="Bytes">{{.Size}}</td><td data-label="SHA-256"><code>{{.SHA256}}</code></td></tr>{{end}}</tbody></table>
{{if .Facts.Intent.Retry}}<p>Explicit retry of <code>{{.Facts.Intent.Retry.AttemptID}}</code>, committed prefix SHA-256 <code>{{.Facts.Intent.Retry.SHA256}}</code>.</p>{{end}}
{{range .Facts.Intent.ExpectedReferences}}<p>Expected {{.Kind}}: <code>{{.Value}}</code></p>{{end}}
<ol class="timeline" start="0">{{range .Events}}<li value="{{.Sequence}}"><span class="event-heading">{{.Kind}}</span><time class="event-time">{{.ObservedAt}}</time>{{range .References}}<p>Receipt {{.Kind}}: <code>{{.Value}}</code></p>{{end}}{{range .Observations}}<p>{{.Kind}}: <strong>{{.Value}}</strong>. {{.Origin}}; {{.Code}}{{if .HTTPStatus}}; HTTP {{.HTTPStatus}}{{end}}.</p>{{if .TLS}}<p><code>{{.TLS}}</code></p>{{end}}{{range .References}}<p class="compact">Observation reference {{.Kind}}: <code>{{.Value}}</code></p>{{end}}{{if .Details}}<details><summary>Observation facts</summary><pre>{{.Details}}</pre></details>{{end}}{{end}}</li>{{end}}</ol>
</article>{{else}}<p class="note">No delivery evidence selected. This does not establish that no delivery occurred.</p>{{end}}
</section>
<section id="exceptions"><h2>Exceptions and evidence gaps</h2>{{range .Exceptions}}<div class="exception"><strong>{{.Scope}}</strong><p>{{.Message}}</p></div>{{else}}<p>No exceptions were identified in the supported recorded facts. This does not establish authenticity or unrecorded outcomes.</p>{{end}}
{{range .Coverage.CollectionNotes}}<p class="note">Collector assertion: {{.Count}} ignored orphan temporary entries for attempt <code>{{.AttemptID}}</code>. Historical presence is not independently checked.</p>{{end}}
</section>
<section id="evidence"><h2>Evidence sources</h2><dl class="facts"><dt>Normalizer</dt><dd>{{.Normalizer.Name}} {{.Normalizer.Version}}</dd><dt>Collector</dt><dd>{{.Collector.Name}} {{.Collector.Version}}</dd><dt>Index SHA-256</dt><dd><code class="digest">{{.IndexSHA256}}</code></dd><dt>Normalization manifest</dt><dd><code class="digest">{{.ManifestSHA256}}</code></dd><dt>Retained sources</dt><dd>{{count (len .Sources) "source document" "source documents"}}; {{.SourceBytes}} raw bytes</dd></dl>
{{range .Boundaries}}<p class="boundary">{{.}}</p>{{end}}
<details><summary>Source kinds and exact digests</summary><table class="responsive"><thead><tr><th>Source</th><th>Bytes</th><th>SHA-256</th></tr></thead><tbody>{{range .Sources}}<tr><td data-label="Source"><span class="source-kind">{{.Kind}}</span><br><code>{{.ID}}</code></td><td data-label="Bytes">{{.Size}}</td><td data-label="SHA-256"><code>{{.SHA256}}</code></td></tr>{{end}}</tbody></table></details>
</section>
<footer>Self-contained offline rendering. URLs are displayed as text. Keep the original JSON for machine inspection.</footer>
</main></div></body></html>
